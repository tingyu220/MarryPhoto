{
  "name": "wedding-memory",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build && node scripts/postbuild.mjs",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "render-check": "node scripts/render-check.mjs",
    "budget": "node scripts/check-budget.mjs",
    "photos": "node scripts/process-images.mjs",
    "photos:force": "node scripts/process-images.mjs --force",
    "photos:check": "node scripts/process-images.mjs --check",
    "placeholders": "node scripts/make-placeholders.mjs"
  },
  "dependencies": {
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "photoswipe": "^5.4.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "exifr": "^7.1.3",
    "sass": "^1.83.0",
    "sharp": "^0.33.5",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vue-tsc": "^2.2.0"
  }
}
